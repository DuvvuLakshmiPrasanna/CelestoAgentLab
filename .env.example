# Copy to .env and edit:  cp .env.example .env
# PLACEHOLDERS ONLY. Never commit a real .env or a live key (the repo is checked for this).

# --- Celesto: where the guests run -------------------------------------------------
# local = open-source runtime on this machine (Linux+KVM Firecracker, or macOS QEMU)
# cloud = Celesto Cloud (needs an API key from celesto.ai -> Settings -> Security)
CELESTO_PROVIDER=cloud
CELESTO_API_KEY=replace-me
# Local runtime backend (firecracker needs KVM; use qemu on macOS)
CELESTO_BACKEND=firecracker

# --- LLM for the optional planner (any OpenAI-compatible endpoint) ----------------
# While LLM_API_KEY / LLM_MODEL are still placeholders the deterministic scripted planner is used.
LLM_BASE_URL=https://example-llm-host/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-a-model-name

# --- Control plane ----------------------------------------------------------------
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger
API_PORT=8080
# Interface the API binds to inside the container
API_HOST=0.0.0.0
LOG_LEVEL=info
# Where the agent harness posts run states (defaults to http://localhost:$API_PORT)
LEDGER_URL=http://localhost:8080
# Directories the API serves reports / the audit log from
REPORTS_DIR=reports
LOGS_DIR=logs
# POST /api/jobs: how many grading jobs may run at once
MAX_CONCURRENT_JOBS=2

# --- Agent behaviour --------------------------------------------------------------
# Step-failure policy: resume | rollback | fresh   (see "State and failure design")
FAILURE_POLICY=rollback
# Per-test-case time limit enforced inside the guest, seconds
HIDDEN_TEST_TIMEOUT_S=3
# Modeled price used for cost_usd (Celesto Micro size, USD per hour)
SANDBOX_PRICE_PER_HOUR=0.015

# --- Emulated provider (stand-in for hosts without KVM or a Celesto key) -----------
# 1 = use the Linux-namespace jail instead of Celesto. Linux + root only. Reports say which was used.
EMULATE_CELESTO=0
EMULATOR_HOME=.sandbox-emulator
GUEST_MEMORY_LIMIT_MB=1024
GUEST_CPU_LIMIT_S=30
